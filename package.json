{
  "name": "momentum",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app/src --max-warnings=0",
    "test": "vitest run",
    "skills:build": "node scripts/skills.mjs",
    "skills:check": "node scripts/skills.mjs --check",
    "release:check": "node scripts/release-check.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run skills:check && npm run release:check"
  },
  "dependencies": {
    "dexie": "4.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "$vite"
  }
}
